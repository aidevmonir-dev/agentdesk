# Copy to .env and fill in. Never commit the real .env.

# Required in production: a long random string.
SECRET_KEY=
# 1 for local development only.
DEBUG=0
ALLOWED_HOSTS=agent.example.com
CSRF_TRUSTED_ORIGINS=https://agent.example.com

# Claude API key from https://platform.claude.com/ . Without it the app still runs
# the scripted example tasks through the real tools and approval queue.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Limits (defaults shown).
MAX_TOOL_ROUNDS=8
MESSAGES_PER_IP_PER_DAY=30
MESSAGES_PER_DAY_TOTAL=300
RETENTION_HOURS=24
TIME_ZONE=Europe/Zurich
